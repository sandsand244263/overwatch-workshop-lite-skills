设置
{
	主程序
	{
		描述: "大厅数值边界：都写在界面上能滑到的位置，必须零报错"
		模式名称: "大厅边界"
	}

	大厅
	{
		玩家上限 队伍1: 6
		玩家上限 队伍2: 6
		观战者人数上限: 12
		自由混战人数上限: 12
		玩家断线时暂停游戏: 是
		最低延迟（毫秒）: 100000000
	}

	模式
	{
		死斗
		{
			随机英雄复生: 开启
		}

		综合
		{
			复生时间: 1%
		}
	}
}

规则("保持一个全局变量在动")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待(1, 无视条件);
	}
}
