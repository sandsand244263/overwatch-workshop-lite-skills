设置
{
	主程序
	{
		描述: "语法探测：只验证导入"
		模式名称: "语法探测"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			允许切换英雄: 关闭
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
			重装职责被动生命值加成: 禁用
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: fast
		1: slow
}

规则("最小等待间隔")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(真);
			修改全局变量(fast, 加, 1);
			等待(0.016, 无视条件);
		End;
	}
}

规则("对照0.1秒")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(真);
			修改全局变量(slow, 加, 1);
			等待(0.100, 无视条件);
		End;
	}
}

规则("报数")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待(10, 无视条件);
		记入查看器(自定义字符串("FAST {0} SLOW {1}", 全局.fast, 全局.slow));
	}
}
