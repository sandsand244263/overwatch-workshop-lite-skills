设置
{
	主程序
	{
		描述: "语法探测：只验证导入"
		模式名称: "语法探测"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			允许切换英雄: 关闭
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
			重装职责被动生命值加成: 禁用
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: arr
		1: x
		2: c

	玩家:
		0: pCount
}

规则("A_数组追加")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		修改全局变量(arr, 添加至数组, 1);
		修改全局变量(arr, 添加至数组, 2);
		修改全局变量(arr, 添加至数组, 3);
		记入查看器(自定义字符串("A_LEN {0} first {1}", 数量(全局.arr), 数组中的值(全局.arr, 0)));
		记入查看器(自定义字符串("A_THIRD {0}", 数组中的值(全局.arr, 2)));
	}
}

规则("B_自我伤害致死")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待(12, 无视条件);
		记入查看器(自定义字符串("B_BEFORE {0}", 事件玩家.pCount));
		伤害(事件玩家, 事件玩家, 1000);
	}
}

规则("C_阵亡记录")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	动作
	{
		记入查看器(自定义字符串("C_DEATH pcount {0}", 事件玩家.pCount));
	}
}

规则("D_等待带条件")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		设置全局变量(x, 1);
		等待(0.100, 无视条件);
		记入查看器(自定义字符串("D_WAITCOND ok {0}", 全局.x));
	}
}

规则("E_中断跳出")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(真);
			修改全局变量(c, 加, 1);
			If(全局.c >= 3);
				中断;
			End;
			等待(0.100, 无视条件);
		End;
		记入查看器(自定义字符串("E_BREAK c {0}", 全局.c));
	}
}
