设置
{
	主程序
	{
		描述: "语法探测：只验证导入"
		模式名称: "语法探测"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

变量
{
	全局:
		0: A
}

规则("HUD测试H01_全部禁用")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			创建HUD文本(事件玩家, 自定义字符串("标题"), 自定义字符串("副标题"), 自定义字符串("tick {0}", 全局.A), 左边, 0, 颜色(白色), 颜色(白色), 颜色(白色), 全部禁用, 默认可见度);
			修改全局变量(A, 加, 1);
			等待(0.250, 无视条件);
		End;
	}
}
