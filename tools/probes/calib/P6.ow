设置
{
	模式
	{
		死斗
		{
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
		}
	}
}

变量
{
	全局:
		0: A
		1: B
}

子程序
{
	0: STest2
}

规则("K20 子程序含两个If")
{
	事件
	{
		子程序;
		STest2;
	}

	动作
	{
		If(全局.A == 0);
			全局.A = 1;
		End;
		If(全局.B == 0);
			全局.B = 1;
		End;
	}
}

规则("K20 调用")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		调用子程序(STest2);
		调用子程序(STest2);
	}
}
