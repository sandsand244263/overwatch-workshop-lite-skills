设置
{
	主程序
	{
		描述: "块注释里写了同一句规则名，不该被判重名（v3.24.1 回归）"
		模式名称: "块注释规则名"
	}

	大厅
	{
		地图轮换: 完成比赛后
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			游戏模式开始: 即时
		}
	}
}

/*
下面这段是用户自己留的草稿，被注释掉了：
规则("A")
{
	事件
	{
		持续 - 全局;
	}
	动作
	{
		等待(0, 无视条件);
	}
}
*/

规则("A")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		记入查看器(自定义字符串("块注释里的同名规则不算重名"));
		等待(1, 无视条件);
	}
}
