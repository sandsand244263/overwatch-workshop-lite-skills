设置
{
	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: spots
	玩家:
		0: n
}

规则("行内注释不该影响括号统计")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		// 折行 + 行内注释混在一起：语料里常见，括号数必须按合并前的原文算
		全局.spots = 数组( 数组(矢量(108.4, -11.49, -170.46), 矢量(113.65, -11.49, -156.81)),//【点位1】请替换
			数组(矢量(20.05, 29.92, -127), 矢量(9.90, 29.85, -135.18)),//【点位2】请替换
			数组(矢量(-32.19, -1.0, -120))); // 最后一项
		事件玩家.n = 数量(全局.spots);
		记入查看器(自定义字符串("[probe] 点位 {0} 组", 事件玩家.n));
	}
}
