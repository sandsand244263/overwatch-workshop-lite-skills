设置
{
	主程序
	{
		描述: "语法探测：只验证导入"
		模式名称: "语法探测"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			允许切换英雄: 关闭
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
			重装职责被动生命值加成: 禁用
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: arr
		1: forSum
		3: i

	玩家:
		0: pCount
}

规则("A_For循环")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		For 全局变量(i, 1, 5, 1);
			全局.forSum += 全局.i;
		End;
		记入查看器(自定义字符串("A_FOR sum={0}", 全局.forSum));
	}
}

规则("C_数组操作")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		全局.arr += 1;
		全局.arr += 2;
		全局.arr += 3;
		记入查看器(自定义字符串("C_ARR len={0} first={1}", 数量(全局.arr), 全局.arr[0]));
		记入查看器(自定义字符串("C_ARR third={0}", 全局.arr[2]));
	}
}

规则("D_自动加玩家变量")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		事件玩家.pCount += 1;
		事件玩家.pCount += 1;
		记入查看器(自定义字符串("D_ADD pcount={0}", 事件玩家.pCount));
	}
}

规则("E_自动自杀与复活")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待(4, 无视条件);
		记入查看器(自定义字符串("E_BEFORE pcount={0}", 事件玩家.pCount));
		击杀(事件玩家, 事件玩家);
	}
}

规则("F_阵亡时记玩家变量")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	动作
	{
		记入查看器(自定义字符串("F_DEATH pcount={0}", 事件玩家.pCount));
	}
}

规则("G_复生时记玩家变量")
{
	事件
	{
		玩家加入比赛;
		双方;
		全部;
	}

	动作
	{
		记入查看器(自定义字符串("G_JOIN pcount={0}", 事件玩家.pCount));
	}
}