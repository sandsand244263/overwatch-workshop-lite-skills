设置
{
	主程序
	{
		描述: "T15 基准：英雄页 受到伤害量 200%，规则不设修正。打 100 点应掉 200"
		模式名称: "T15-0 基准"
	}

	大厅
	{
		玩家上限 队伍1: 12
		玩家上限 队伍2: 0
		自由混战人数上限: 12
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			路霸
			{
				受到伤害量: 200%
			}

			启用英雄
			{
				路霸
			}
		}
	}
}

变量
{
	全局:
		0: hpBefore
}

规则("T15 基准 打一枪")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		记入查看器(自定义字符串("T15-0 开始：比赛开始后 2 秒打 100 点；英雄受到伤害量 200%，规则不设修正"));
		等待直到(游戏正在进行中(), 999);
		等待(2, 无视条件);
		全局.hpBefore = 生命值(事件玩家);
		伤害(事件玩家, 事件玩家, 100);
		等待(0.3, 无视条件);
		记入查看器(自定义字符串("T15-0|英雄=200%|规则=不设|打=100|前={0}|后={1}|掉={2}", 全局.hpBefore, 生命值(事件玩家), 全局.hpBefore - 生命值(事件玩家)));
	}
}
