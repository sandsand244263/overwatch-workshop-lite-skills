// v17 探针 P15：变量块里声明但从不赋值的变量，读出来是不是 0（对照：赋过值的那个变量）
设置
{
	主程序
	{
		描述: "v17 探针 P15：未赋值变量读出来是不是 0"
		模式名称: "P15 未赋值变量"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 1
		玩家上限 队伍2: 0
		自由混战人数上限: 1
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: t
		1: u
		2: v
		3: c13
		4: c14
}

规则("时钟 t")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);
			全局.t = 全局.t + 1;
			等待(1, 无视条件);
		End;
	}
}

规则("c13/c14 未赋值 vs 已赋值")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		设置全局变量(v, 7);
		While(全局.t < 12);
			全局.c13 = 全局.u;
			全局.c14 = 全局.v;
			记入查看器(自定义字符串("[c13] c13={0}", 全局.c13));
			记入查看器(自定义字符串("[c14] c14={0}", 全局.c14));
			等待(1, 无视条件);
		End;
	}
}

规则("工位隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		隐藏英雄HUD(事件玩家);
		隐藏游戏模式HUD(事件玩家);
		开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
	}
}
