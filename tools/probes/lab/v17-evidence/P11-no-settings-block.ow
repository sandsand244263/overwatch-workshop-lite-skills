// v17 探针 P11：故意没有「设置」整块（只留变量 + 规则）

变量
{
	全局:
		0: t
		1: c8
}

规则("时钟 t")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);
			全局.t = 全局.t + 1;
			等待(1, 无视条件);
		End;
	}
}

规则("c8 无设置块心跳")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);
			全局.c8 = 全局.c8 + 1;
			记入查看器(自定义字符串("[c8] c8={0}", 全局.c8));
			等待(1, 无视条件);
		End;
	}
}

规则("工位隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		隐藏英雄HUD(事件玩家);
		隐藏游戏模式HUD(事件玩家);
		开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
	}
}
