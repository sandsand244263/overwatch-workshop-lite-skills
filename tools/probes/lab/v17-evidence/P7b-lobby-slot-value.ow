// v17 探针 P7b：团队模式 + 自由混战人数上限 2 —— 导入后**不要开局**，去大厅面板看这一栏显示 2 还是被置 0
设置
{
	主程序
	{
		描述: "v17 探针 P7b：团队模式 + 自由混战人数上限 2（看大厅栏位）"
		模式名称: "P7b 大厅栏位"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 5
		玩家上限 队伍2: 0
		自由混战人数上限: 2
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		攻击护送
		{
			启用地图
			{
				国王大道 972777519512068194
			}
			职责限制: 1重装，2输出，2支援
		}

		综合
		{
			游戏模式开始: 即时
		}
	}
}

变量
{
	全局:
		0: t
		1: c1
}

规则("时钟 t")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);
			全局.t = 全局.t + 1;
			等待(1, 无视条件);
		End;
	}
}

规则("c1 心跳")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);
			全局.c1 = 全局.c1 + 1;
			记入查看器(自定义字符串("[c1] c1={0}", 全局.c1));
			等待(1, 无视条件);
		End;
	}
}

规则("工位隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		隐藏英雄HUD(事件玩家);
		隐藏游戏模式HUD(事件玩家);
		开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
	}
}
