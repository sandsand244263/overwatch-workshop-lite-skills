设置
{
	主程序
	{
		描述: "v17 探针 P13：变量 Temp 与 temp 只差大小写"
		模式名称: "P13 大小写变量名"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 1
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: t
		1: Temp
		2: temp
		3: c10
		4: c11
}

规则("时钟 t")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);
			全局.t = 全局.t + 1;
			等待(1, 无视条件);
		End;
	}
}

规则("c10/c11 大小写同名")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		设置全局变量(Temp, 1);
		设置全局变量(temp, 2);
		While(全局.t < 12);
			全局.c10 = 全局.Temp;
			全局.c11 = 全局.temp;
			记入查看器(自定义字符串("[c10] c10={0}", 全局.c10));
			记入查看器(自定义字符串("[c11] c11={0}", 全局.c11));
			等待(1, 无视条件);
		End;
	}
}

规则("工位隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		隐藏英雄HUD(事件玩家);
		隐藏游戏模式HUD(事件玩家);
		开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
	}
}
