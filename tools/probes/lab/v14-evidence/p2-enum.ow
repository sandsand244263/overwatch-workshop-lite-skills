	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 立即
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: b
}

规则("p2 对照组规则")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		记入查看器(自定义字符串("[p2] 设置块整块被收下，规则已执行"));
	}
}
