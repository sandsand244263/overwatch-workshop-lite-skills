设置
{
	主程序
	{
		描述: "v14 证据格 p4c：p4 的阳性对照，循环体第一条换成等待（只导入，不要点开始）"
		模式名称: "v14 p4c"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: b
}

规则("p4c 循环体第一条")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		记入查看器(自定义字符串("[p4c] 进入规则"));
		While(假);
			等待(0.5, 无视条件);
			记入查看器(自定义字符串("[p4c] 循环体内第二条"));
		End;
		记入查看器(自定义字符串("[p4c] 循环之后"));
	}
}
