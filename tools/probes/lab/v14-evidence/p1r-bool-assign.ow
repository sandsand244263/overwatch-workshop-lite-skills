设置
{
	主程序
	{
		描述: "v14 证据格 p1r：整句赋值里写 ASCII 真假词（p1 的修正版）"
		模式名称: "v14 p1r"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: b
}

规则("对照组")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		记入查看器(自定义字符串("[p1r] 进入规则"));
		等待(0.5, 无视条件);
		全局.b = True;
		记入查看器(自定义字符串("[p1r] 这行还能打到说明整条被收下"));
	}
}
