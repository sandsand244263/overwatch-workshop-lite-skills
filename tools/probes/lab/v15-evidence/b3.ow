设置
{
	主程序
	{
		描述: "v15 b3：等待直到 期间条件由假变真再变假，会不会漏掉这次上升沿"
		模式名称: "v15 b3"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 500
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: tick
		1: flagA
		2: flagB
		3: flagD
}

规则("b0 节拍")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 60);
			等待(1, 无视条件);
			修改全局变量(tick, 加, 1);
		End;
	}
}

规则("b3t 时序发生器")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 5, 999);
		设置全局变量(flagA, 真);
		设置全局变量(flagD, 真);
		记入查看器(自定义字符串("[b3t] tick={0} flagA=真 flagD=真", 全局.tick));
		等待直到(全局.tick >= 6, 999);
		设置全局变量(flagA, 假);
		记入查看器(自定义字符串("[b3t] tick={0} flagA 已变假", 全局.tick));
		等待直到(全局.tick >= 8, 999);
		设置全局变量(flagB, 真);
		等待(0.2, 无视条件);
		设置全局变量(flagB, 假);
		记入查看器(自定义字符串("[b3t] tick={0} flagB 0.2 秒脉冲结束", 全局.tick));
	}
}

规则("b3A 等一个 2 秒宽的脉冲")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 2, 999);
		等待直到(全局.flagA == 真, 20);
		记入查看器(自定义字符串("[b3A] 醒来 tick={0} 此刻flagA={1}", 全局.tick, 全局.flagA));
	}
}

规则("b3B 等一个 0.2 秒宽的脉冲")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 2, 999);
		等待直到(全局.flagB == 真, 20);
		记入查看器(自定义字符串("[b3B] 醒来 tick={0} 此刻flagB={1}", 全局.tick, 全局.flagB));
	}
}

规则("b3D 对照：等一个变成真后不再变的标志")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 2, 999);
		等待直到(全局.flagD == 真, 20);
		记入查看器(自定义字符串("[b3D] 醒来 tick={0} 此刻flagD={1}", 全局.tick, 全局.flagD));
	}
}
