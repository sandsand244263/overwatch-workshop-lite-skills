设置
{
	主程序
	{
		描述: "v15 b1：击杀事件挂在每名玩家实例上，一次击杀到底记给谁、记几次"
		模式名称: "v15 b1"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 500
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: tick
		1: total

	玩家:
		0: k
}

规则("b0 节拍")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 60);
			等待(1, 无视条件);
			修改全局变量(tick, 加, 1);
		End;
	}
}

规则("b5 生成四个机器人")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		生成机器人(英雄(死神), 所有队伍, -1, 空, 空);
		生成机器人(英雄(安娜), 所有队伍, -1, 空, 空);
		生成机器人(英雄(路霸), 所有队伍, -1, 空, 空);
		生成机器人(英雄(卢西奥), 所有队伍, -1, 空, 空);
	}
}

规则("b1s 同一个击杀者打两次")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 15, 999);
		记入查看器(自定义字符串("[b1s] 第一刀 tick={0}", 全局.tick));
		伤害(数组中的值(所有玩家(所有队伍), 1), 数组中的值(所有玩家(所有队伍), 0), 1000);
		等待(3, 无视条件);
		记入查看器(自定义字符串("[b1s] 第二刀 tick={0}", 全局.tick));
		伤害(数组中的值(所有玩家(所有队伍), 2), 数组中的值(所有玩家(所有队伍), 0), 1000);
	}
}

规则("b1k 击杀事件计数")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		修改玩家变量(事件玩家, k, 加, 1);
		修改全局变量(total, 加, 1);
		记入查看器(自定义字符串("[b1k] tick={0} 击杀者k={1} 总击杀={2}", 全局.tick, 事件玩家.k, 全局.total));
	}
}

规则("b1p 每名玩家播报自己的 k")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(全局.tick < 50);
			等待(10, 无视条件);
			记入查看器(自定义字符串("[b1p] tick={0} 我的k={1}", 全局.tick, 事件玩家.k));
		End;
	}
}
