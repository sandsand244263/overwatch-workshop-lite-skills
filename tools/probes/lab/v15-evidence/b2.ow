设置
{
	主程序
	{
		描述: "v15 b2：本地玩家 当读取目标 vs 当动作目标，各配一个对照"
		模式名称: "v15 b2"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 500
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: tick
}

规则("b0 节拍")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 40);
			等待(1, 无视条件);
			修改全局变量(tick, 加, 1);
		End;
	}
}

规则("b2n 报场上人数（判「人在不在场」用）")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 3, 999);
		记入查看器(自定义字符串("[b2n] 场上玩家数={0} tick={1}", 数量(所有玩家(所有队伍)), 全局.tick));
	}
}

规则("b2z 两个机器人（保证比赛真的开起来）")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		生成机器人(英雄(路霸), 所有队伍, -1, 空, 空);
		生成机器人(英雄(安娜), 所有队伍, -1, 空, 空);
	}
}

规则("b2r 全局规则里读本地玩家")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 40);
			等待(3, 无视条件);
			记入查看器(自定义字符串("[b2r] tick={0} 本地玩家血量={1} 上限={2}", 全局.tick, 生命值(本地玩家), 最大生命值(本地玩家)));
		End;
	}
}

规则("b2c 对照：每名玩家读事件玩家")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(全局.tick < 40);
			等待(3, 无视条件);
			记入查看器(自定义字符串("[b2c] tick={0} 事件玩家血量={1} 英雄={2}", 全局.tick, 生命值(事件玩家), 所用英雄(事件玩家)));
		End;
	}
}

规则("b2a 全局规则里伤害本地玩家")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 12, 999);
		记入查看器(自定义字符串("[b2a] 打之前 tick={0}", 全局.tick));
		伤害(本地玩家, 本地玩家, 25);
		记入查看器(自定义字符串("[b2a] 打之后 tick={0}", 全局.tick));
	}
}

规则("b2d 受伤事件（动作到底有没有落地）")
{
	事件
	{
		玩家受到伤害;
		双方;
		全部;
	}

	动作
	{
		记入查看器(自定义字符串("[b2d] tick={0} 受伤者={1} 伤害量={2}", 全局.tick, 事件玩家, 事件伤害));
	}
}
