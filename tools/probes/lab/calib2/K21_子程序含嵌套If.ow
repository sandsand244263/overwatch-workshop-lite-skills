子程序
{
	0: STest2
}

规则("K21 子程序含嵌套If")
{
	事件
	{
		子程序;
		STest2;
	}

	动作
	{
		If(全局.A == 0);
			全局.A = 1;
			If(全局.B == 0);
				全局.B = 1;
			End;
		End;
	}
}

规则("K21 调用")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		调用子程序(STest2);
		调用子程序(STest2);
	}
}
