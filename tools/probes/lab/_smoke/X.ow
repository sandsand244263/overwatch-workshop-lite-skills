设置
{
	主程序
	{
		描述: "探针模板：8 格（If真、If假、条件块真、条件块假、While上限、While假、每名玩家、每名玩家If假），每秒打点一次，12 秒后自停"
		模式名称: "探针"
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: t
		1: c1
		2: c2
		3: c3
		4: c4
		5: c5
		6: c6
		7: c7
		8: c8
		9: i5
}

规则("隐蔽 屏幕干净")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		隐藏英雄HUD(事件玩家);
		隐藏游戏模式HUD(事件玩家);
		开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：读数跑完就连隐蔽一起收
			等待(1, 无视条件);
			隐藏英雄HUD(事件玩家);
			隐藏游戏模式HUD(事件玩家);
			开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
		End;
	}
}

规则("时钟 每秒一格")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 计时上限，走完就退出
			等待(1, 无视条件);
			全局.t = 全局.t + 1;
		End;
		记入查看器(自定义字符串("[clock] t={0}", 全局.t));
	}
}

规则("格01 c1 If真")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		// 结构：If真 —— 循环体内 If(恒真) 包住计数器：应与「无条件」一致
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：时钟走完就停
			等待(1, 无视条件);
			If(1 == 1);
				全局.c1 = 全局.c1 + 1;
			End;
			记入查看器(自定义字符串("[c1] c1={0}", 全局.c1));
		End;
	}
}

规则("格02 c2 If假")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		// 结构：If假 —— 对照组：结构与 If真 完全一样，只有条件恒假 → 每轮都打点但值恒为 0
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：时钟走完就停
			等待(1, 无视条件);
			If(1 == 2);
				全局.c2 = 全局.c2 + 1;
			End;
			记入查看器(自定义字符串("[c2] c2={0}", 全局.c2));
		End;
	}
}

规则("格03 c3 条件块真")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		1 == 1;
	}

	动作
	{
		// 结构：条件块真 —— 条件写进「条件」块且恒真：只在上升沿跑一次，这一轮循环跑完即停
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：时钟走完就停
			等待(1, 无视条件);
			全局.c3 = 全局.c3 + 1;
			记入查看器(自定义字符串("[c3] c3={0}", 全局.c3));
		End;
	}
}

规则("格04 c4 条件块假")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		1 == 2;
	}

	动作
	{
		// 结构：条件块假 —— 对照组：结构与 条件块真 一样，条件恒假 → 整条规则不执行，日志里不该有它的键
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：时钟走完就停
			等待(1, 无视条件);
			全局.c4 = 全局.c4 + 1;
			记入查看器(自定义字符串("[c4] c4={0}", 全局.c4));
		End;
	}
}

规则("格05 c5 While上限")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		// 结构：While上限 —— 内层 While(aux<3) 有硬上限：每轮 +3（同时验证内层循环能正常退出）
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：时钟走完就停
			等待(1, 无视条件);
			全局.i5 = 0;
			While(全局.i5 < 3);
				全局.i5 = 全局.i5 + 1;
				全局.c5 = 全局.c5 + 1;
			End;
			记入查看器(自定义字符串("[c5] c5={0}", 全局.c5));
		End;
	}
}

规则("格06 c6 While假")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		// 结构：While假 —— 对照组：结构与 While上限 一样，条件恒假 → 内层循环一次都不进，值恒为 0
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：时钟走完就停
			等待(1, 无视条件);
			While(1 == 2);
				全局.c6 = 全局.c6 + 1;
			End;
			记入查看器(自定义字符串("[c6] c6={0}", 全局.c6));
		End;
	}
}

规则("格07 c7 每名玩家")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		// 结构：每名玩家 —— 每名玩家 = 每人一个实例：两人在场时读数约为单人两倍
		// 每名玩家 = 每人一个实例，计数器是全局的，读数会按人数放大
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：时钟走完就停
			等待(1, 无视条件);
			全局.c7 = 全局.c7 + 1;
			记入查看器(自定义字符串("[c7] c7={0}", 全局.c7));
		End;
	}
}

规则("格08 c8 每名玩家If假")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		// 结构：每名玩家If假 —— 对照组：结构与 每名玩家 一样，条件恒假 → 每人每轮打点但值恒为 0
		// 每名玩家 = 每人一个实例，计数器是全局的，读数会按人数放大
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 12);          // 退出条件：时钟走完就停
			等待(1, 无视条件);
			If(1 == 2);
				全局.c8 = 全局.c8 + 1;
			End;
			记入查看器(自定义字符串("[c8] c8={0}", 全局.c8));
		End;
	}
}
