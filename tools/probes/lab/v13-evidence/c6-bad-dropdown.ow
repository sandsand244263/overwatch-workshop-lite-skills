设置
{
	主程序
	{
		描述: "v13 证据格 c6：创建HUD文本 的坐标写「中间」（选项里没有）"
		模式名称: "v13 c6"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

规则("c6 下拉非法值")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		记入查看器(自定义字符串("[c6] 开始"));
		创建HUD文本(事件玩家, 自定义字符串("c6"), 空, 自定义字符串("x"), 中间, 0, 颜色(白色), 颜色(白色), 颜色(白色), 可见和字符串, 默认可见度);
		记入查看器(自定义字符串("[c6] 之后"));
	}
}
