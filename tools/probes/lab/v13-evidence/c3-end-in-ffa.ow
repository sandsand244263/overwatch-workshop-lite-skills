设置
{
	主程序
	{
		描述: "v13 证据格 c3：死斗里用队伍类结束动作（动作名见动作行）"
		模式名称: "v13 c3"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: tick
}

规则("c3 死斗里的队伍结束动作")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(游戏正在进行中() == 真, 120);
		记入查看器(自定义字符串("[c3] 开赛，准备用队伍结束动作"));
		宣告队伍胜利(队伍1);
		记入查看器(自定义字符串("[c3] 之后仍在执行"));
	}
}
