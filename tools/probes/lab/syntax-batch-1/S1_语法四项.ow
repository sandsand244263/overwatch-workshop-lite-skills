设置
{
	主程序
	{
		描述: "S1 一次导入确认 4 个写法：综合层、队伍1层、布尔词写 关闭、大厅 12+0"
		模式名称: "S1 语法四项"
	}

	大厅
	{
		玩家上限 队伍1: 12
		玩家上限 队伍2: 0
		自由混战人数上限: 12
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			路霸
			{
				受到伤害量: 200%
				主要攻击模式: 关闭
			}

			启用英雄
			{
				路霸
			}
		}

		队伍1
		{
			路霸
			{
				治疗量: 150%
			}
		}
	}
}

变量
{
	全局:
		0: hpBefore
}

规则("S1 打一枪")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		等待(2, 无视条件);
		记入查看器(自定义字符串("S1 导入成功：四项写法全部被游戏接受"));
		全局.hpBefore = 生命值(事件玩家);
		伤害(事件玩家, 事件玩家, 100);
		等待(0.3, 无视条件);
		记入查看器(自定义字符串("S1|英雄=200%|规则不设|打=100|前={0}|后={1}|掉={2}", 全局.hpBefore, 生命值(事件玩家), 全局.hpBefore - 生命值(事件玩家)));
	}
}
