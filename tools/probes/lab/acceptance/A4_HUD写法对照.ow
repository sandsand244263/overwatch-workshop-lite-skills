设置
{
	主程序
	{
		描述: "四组 HUD 写法对照：哪一组屏幕上真的有字（同一时间只差写法）"
		模式名称: "A4-HUD写法对照"
	}

	大厅
	{
		玩家上限 队伍1: 12
		玩家上限 队伍2: 0
		自由混战人数上限: 12
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			路霸
			{
				受到伤害量: 100%
			}

			启用英雄
			{
				路霸
			}
		}
	}
}

变量
{
	玩家:
		0: id1
		1: id2
		2: id3
		3: id4
}

规则("四组对照")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		等待(1, 无视条件);

		创建HUD文本(事件玩家, 自定义字符串("①空颜色"), 自定义字符串("子标题"),
			自定义字符串("排序1-空颜色"), 顶部, 1, 空, 空, 空, 可见和字符串, 默认可见度);
		事件玩家.id1 = 上一个文本ID;

		创建HUD文本(事件玩家, 自定义字符串("②显式颜色"), 自定义字符串("子标题"),
			自定义字符串("排序2-显式颜色"), 顶部, 2, 颜色(白色), 颜色(黄色), 颜色(水绿色),
			可见和字符串, 默认可见度);
		事件玩家.id2 = 上一个文本ID;

		创建HUD文本(事件玩家, 自定义字符串("③只选可见"), 自定义字符串("子标题"),
			自定义字符串("排序3-只选可见"), 顶部, 3, 颜色(白色), 颜色(黄色), 颜色(水绿色),
			可见, 默认可见度);
		事件玩家.id3 = 上一个文本ID;

		创建HUD文本(所有玩家(所有队伍), 自定义字符串("④所有玩家"), 自定义字符串("子标题"),
			自定义字符串("排序4-所有玩家"), 顶部, 4, 颜色(白色), 颜色(黄色), 颜色(水绿色),
			可见和字符串, 默认可见度);
		事件玩家.id4 = 上一个文本ID;

		记入查看器(自定义字符串("[对照] 四个文本ID：{0} / {1} / {2}", 事件玩家.id1, 事件玩家.id2, 事件玩家.id3));
		记入查看器(自定义字符串("[对照] 第四个ID：{0}（排序 4，可见=所有玩家）", 事件玩家.id4));
		记入查看器(自定义字符串("[对照] 请告诉我：①②③④ 哪几个屏幕上有字"));
	}
}
