设置
{
	主程序
	{
		描述: "技能验收训练场（诊断版）：每步能读到的状态都打进查看器，一条日志最多 3 个值"
		模式名称: "验收训练场-诊断版"
	}

	大厅
	{
		玩家上限 队伍1: 12
		玩家上限 队伍2: 0
		自由混战人数上限: 12
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			路霸
			{
				受到伤害量: 200%
				链钩冷却时间: 0%
			}

			启用英雄
			{
				路霸
			}
		}
	}
}

变量
{
	全局:
		0: colors
		1: hpBefore
		2: tick
		3: deaths
	玩家:
		0: pts
		1: streak
		2: hudId
}

子程序
{
	0: S_Reset
	1: S_Burst
}

规则("初始化")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		全局.colors = 数组(颜色(白色), 颜色(黄色), 颜色(水绿色));
		记入查看器(自定义字符串("[初始化-改前] 生命值 {0} / 最大 {1} / 重生室 {2}",
			生命值(事件玩家), 最大生命值(事件玩家), 在重生室中(事件玩家)));
		记入查看器(自定义字符串("[初始化-改前] 存活 {0} / 分数 {1} / 连击 {2}",
			存活(事件玩家), 事件玩家.pts, 事件玩家.streak));
		设置最大生命值(事件玩家, 50);
		设置移动速度(事件玩家, 100);
		事件玩家.pts = 0;
		事件玩家.streak = 0;
		调用子程序(S_Reset);
		等待(0.1, 无视条件);
		记入查看器(自定义字符串("[初始化-改后] 生命值 {0} / 最大 {1} / 数组 {2} 项",
			生命值(事件玩家), 最大生命值(事件玩家), 数量(全局.colors)));
	}
}

规则("HUD 刷新")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		While(真);
			事件玩家.hudId = 创建HUD文本(事件玩家, 自定义字符串("验收训练场"),
				自定义字符串("{0} 分", 事件玩家.pts),
				自定义字符串("{0} 分｜连击 {1}", 事件玩家.pts, 事件玩家.streak),
				顶部, 0, 空, 空, 空, 可见和字符串, 默认可见度);
			全局.tick = 全局.tick + 1;
			If(全局.tick % 10 == 1);
				记入查看器(自定义字符串("[HUD] 第 {0} 次刷新 / 文本ID {1}",
					全局.tick, 事件玩家.hudId));
				记入查看器(自定义字符串("[HUD] 分数 {0} / 连击 {1} / 生命值 {2}",
					事件玩家.pts, 事件玩家.streak, 生命值(事件玩家)));
			End;
			等待(0.5, 无视条件);
		End;
	}
}

规则("造成伤害记分")
{
	事件
	{
		玩家造成伤害;
		双方;
		全部;
	}

	动作
	{
		事件玩家.pts = 事件玩家.pts + 1;
		事件玩家.streak = 事件玩家.streak + 1;
		记入查看器(自定义字符串("[伤害] 分数 {0} / 连击 {1} / 生命值 {2}",
			事件玩家.pts, 事件玩家.streak, 生命值(事件玩家)));
		记入查看器(自定义字符串("[伤害] 最大 {0} / 在场玩家 {1} / 存活 {2}",
			最大生命值(事件玩家), 存活玩家数量(所有队伍), 存活(事件玩家)));
		If(事件玩家.streak == 5);
			调用子程序(S_Burst);
		End;
		If(事件玩家.pts >= 25);
			记入查看器(自定义字符串("[胜利] 分数到 {0}，宣告胜利并中断", 事件玩家.pts));
			宣告玩家胜利(事件玩家);
			中断;
		End;
	}
}

规则("阵亡")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	动作
	{
		全局.deaths = 全局.deaths + 1;
		调用子程序(S_Reset);
		记入查看器(自定义字符串("[阵亡] 第 {0} 次 / 分数 {1} / 生命值 {2}",
			全局.deaths, 事件玩家.pts, 生命值(事件玩家)));
		记入查看器(自定义字符串("[阵亡] 最大 {0} / 在重生室 {1} / 连击已清零",
			最大生命值(事件玩家), 在重生室中(事件玩家)));
	}
}

规则("自伤循环")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		While(真);
			等待(3, 无视条件);
			全局.hpBefore = 生命值(事件玩家);
			伤害(事件玩家, 事件玩家, 10);
			等待(0.1, 无视条件);
			记入查看器(自定义字符串("[自伤] 前 {0} → 后 {1} / 掉 {2}",
				全局.hpBefore, 生命值(事件玩家), 全局.hpBefore - 生命值(事件玩家)));
			记入查看器(自定义字符串("[自伤] 最大 {0} / 分数 {1} / 连击 {2}",
				最大生命值(事件玩家), 事件玩家.pts, 事件玩家.streak));
		End;
	}
}

规则("S_Reset")
{
	事件
	{
		子程序;
		S_Reset;
	}

	动作
	{
		事件玩家.streak = 0;
	}
}

规则("S_Burst")
{
	事件
	{
		子程序;
		S_Burst;
	}

	动作
	{
		设置移动速度(事件玩家, 130);
		播放效果(所有玩家(所有队伍), 环状爆炸, 颜色(水绿色), 事件玩家, 2.5);
		记入查看器(自定义字符串("[连击5] 移速→130% / 分数 {0} / 连击 {1}",
			事件玩家.pts, 事件玩家.streak));
		记入查看器(自定义字符串("[连击5] 生命值 {0} / 最大 {1} / 阵亡 {2}",
			生命值(事件玩家), 最大生命值(事件玩家), 全局.deaths));
	}
}
