设置
{
	主程序
	{
		描述: "工位隐蔽：把视角移到空白处（镜头抬头看天），角色与 HUD 都离开画面"
		模式名称: "A7-镜头隐蔽"
	}

	大厅
	{
		玩家上限 队伍1: 12
		玩家上限 队伍2: 0
		自由混战人数上限: 12
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			路霸
			{
				受到伤害量: 100%
			}

			启用英雄
			{
				路霸
			}
		}
	}
}

变量
{
	全局:
		0: tick
}

规则("镜头隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		隐藏英雄HUD(事件玩家);
		隐藏游戏模式HUD(事件玩家);
		开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
		记入查看器(自定义字符串("[A7] 隐蔽配方：HUD 已藏、镜头已抬到高空望天"));
		等待直到(游戏正在进行中(), 999);
		While(真);
			全局.tick = 全局.tick + 1;
			隐藏英雄HUD(事件玩家);
			隐藏游戏模式HUD(事件玩家);
			// 每秒重设：死亡/重生会把镜头和 HUD 状态冲掉
			开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
			If(全局.tick % 10 == 0);
				记入查看器(自定义字符串("[A7] 第 {0} 秒：镜头保持中", 全局.tick));
			End;
			等待(1, 无视条件);
		End;
	}
}
