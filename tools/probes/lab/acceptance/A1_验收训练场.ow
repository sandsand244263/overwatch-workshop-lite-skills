设置
{
	主程序
	{
		描述: "技能验收训练场：自伤循环触发记分、连击、HUD 原地刷新、子程序、特效、胜利与中断"
		模式名称: "验收训练场"
	}

	大厅
	{
		玩家上限 队伍1: 12
		玩家上限 队伍2: 0
		自由混战人数上限: 12
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			路霸
			{
				受到伤害量: 200%
				链钩冷却时间: 0%
			}

			启用英雄
			{
				路霸
			}
		}
	}
}

变量
{
	全局:
		0: colors
		1: hpBefore
	玩家:
		0: pts
		1: streak
}

子程序
{
	0: S_Reset
	1: S_Burst
}

规则("初始化")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		设置不可见(所有玩家(所有队伍), 全部);
		全局.colors = 数组(颜色(白色), 颜色(黄色), 颜色(水绿色));
		设置最大生命值(事件玩家, 50);
		设置移动速度(事件玩家, 100);
		事件玩家.pts = 0;
		事件玩家.streak = 0;
		调用子程序(S_Reset);
		记入查看器(自定义字符串("[验收] 初始化完成：最大生命值 50%（300 点）、移速 100%、数组 {0} 项",
			数量(全局.colors)));
	}
}

规则("HUD 原地刷新")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(真);
			创建HUD文本(本地玩家, 自定义字符串("验收训练场"), 自定义字符串("分数｜连击"),
				自定义字符串("{0} 分｜连击 {1}", 本地玩家.pts, 本地玩家.streak),
				顶部, 0, 颜色(白色), 颜色(黄色), 颜色(水绿色), 字符串, 默认可见度);
			等待(0.5, 无视条件);
		End;
	}
}

规则("造成伤害记分")
{
	事件
	{
		玩家造成伤害;
		双方;
		全部;
	}

	动作
	{
		事件玩家.pts = 事件玩家.pts + 1;
		事件玩家.streak = 事件玩家.streak + 1;
		播放效果(所有玩家(所有队伍), 有益爆炸, 颜色(黄色), 事件玩家, 1);
		If(事件玩家.streak == 5);
			调用子程序(S_Burst);
		End;
		If(事件玩家.pts >= 25);
			宣告玩家胜利(事件玩家);
			中断;
		End;
	}
}

规则("被消灭清连击")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	动作
	{
		调用子程序(S_Reset);
		记入查看器(自定义字符串("[验收] 玩家阵亡：连击清零，累计 {0} 分", 事件玩家.pts));
	}
}

规则("自伤循环")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		While(真);
			等待(3, 无视条件);
			全局.hpBefore = 生命值(事件玩家);
			伤害(事件玩家, 事件玩家, 10);
			等待(0.1, 无视条件);
			记入查看器(自定义字符串("[验收] 自伤 10 点 → 实际掉血 {0}，当前生命值 {1}",
				全局.hpBefore - 生命值(事件玩家), 生命值(事件玩家)));
		End;
	}
}

规则("S_Reset")
{
	事件
	{
		子程序;
		S_Reset;
	}

	动作
	{
		事件玩家.streak = 0;
	}
}

规则("S_Burst")
{
	事件
	{
		子程序;
		S_Burst;
	}

	动作
	{
		设置移动速度(事件玩家, 130);
		播放效果(所有玩家(所有队伍), 环状爆炸, 颜色(水绿色), 事件玩家, 2.5);
		记入查看器(自定义字符串("[验收] 连击到 5：移速提到 130%，当前 {0} 分", 事件玩家.pts));
	}
}
