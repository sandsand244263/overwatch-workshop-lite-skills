设置
{
	主程序
	{
		描述: "HUD 文本 ID 会不会无限增长：每 0.5 秒「先消除再重建」，看 ID 是否被回收"
		模式名称: "A3-HUD-ID对照"
	}

	大厅
	{
		玩家上限 队伍1: 12
		玩家上限 队伍2: 0
		自由混战人数上限: 12
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
				路霸
			{
				受到伤害量: 100%
			}

			启用英雄
			{
				路霸
			}
		}
	}
}

变量
{
	全局:
		0: tick
		1: lastId
	玩家:
		0: hudId
}

规则("消除后重建")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		记入查看器(自定义字符串("[起步] 初始 玩家.hudId = {0} / 全局.lastId = {1}",
			事件玩家.hudId, 全局.lastId));
		While(真);
			消除HUD文本(事件玩家.hudId);
			创建HUD文本(事件玩家, 自定义字符串("A3 对照"),
				自定义字符串("消除后重建"),
				自定义字符串("第 {0} 次刷新", 全局.tick),
				顶部, 0, 空, 空, 空, 可见和字符串, 默认可见度);
			事件玩家.hudId = 上一个文本ID;
			全局.lastId = 事件玩家.hudId;
			全局.tick = 全局.tick + 1;
			If(全局.tick % 10 == 1);
				记入查看器(自定义字符串("[消除重建] 第 {0} 次 / 本次ID {1}",
					全局.tick, 事件玩家.hudId));
			End;
			等待(0.5, 无视条件);
		End;
	}
}
