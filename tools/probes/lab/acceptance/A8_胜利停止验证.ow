设置
{
	主程序
	{
		描述: "验证宣告胜利后规则是否真的停：12 秒跑完，末尾有三条可分辨的标记"
		模式名称: "A8-胜利停止验证"
	}

	大厅
	{
		玩家上限 队伍1: 12
		玩家上限 队伍2: 0
		自由混战人数上限: 12
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			路霸
			{
				受到伤害量: 100%
			}

			启用英雄
			{
				路霸
			}
		}
	}
}

变量
{
	全局:
		0: tick
		1: ended
	玩家:
		0: pts
}

规则("记分与胜利")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		隐藏英雄HUD(事件玩家);
		隐藏游戏模式HUD(事件玩家);
		开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
		等待直到(游戏正在进行中(), 999);
		记入查看器(自定义字符串("[开始] 每 1.5 秒 +1 分，6 分触发胜利"));
		While(全局.ended == 假);
			等待(1.5, 无视条件);
			事件玩家.pts = 事件玩家.pts + 1;
			记入查看器(自定义字符串("[跑] 分数 {0}", 事件玩家.pts));
			If(事件玩家.pts >= 6);
				记入查看器(自定义字符串("[结尾A] 到 6 分：置 ended，接着宣告胜利"));
				全局.ended = 真;
				宣告玩家胜利(事件玩家);
			End;
		End;
		记入查看器(自定义字符串("[结尾B] 主循环已退出（ended=真）"));
	}
}

规则("心跳")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(游戏正在进行中(), 999);
		While(真);
			全局.tick = 全局.tick + 1;
			等待(3, 无视条件);
			记入查看器(自定义字符串("[心跳] 第 {0} 次（独立规则，不受 ended 影响）", 全局.tick));
		End;
	}
}
