// v18 被拒探针 P18：`设置受到伤害(事件玩家, 50%)`——验「% 是取余、写 50% 会被拒」
设置
{
	主程序
	{
		描述: "%s"
		模式名称: "%s"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 1
		玩家上限 队伍2: 0
		自由混战人数上限: 1
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: t
}

规则("50% 当百分号")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);
		设置受到伤害(事件玩家, 50%);
		全局.t = 全局.t + 1;
		记入查看器(自定义字符串("[c1] c1={0}", 全局.t));
	}
}
