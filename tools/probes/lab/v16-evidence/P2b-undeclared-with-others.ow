设置
{
	主程序
	{
		描述: "v16 探针 P2b：全局段声明了 A，动作里却用没声明的 g（隔离变量）"
		模式名称: "P2b 未声明且已有别的全局"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

变量
{
	全局:
		0: A
	玩家:
		0: hp
}

规则("P2b 用未声明的全局 g")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		设置全局变量(A, 1);
		设置全局变量(g, 2);
		记入查看器(自定义字符串("P2b 能导入：说明未声明的 g 不挡导入"));
	}
}
