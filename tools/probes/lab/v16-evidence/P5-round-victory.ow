设置
{
	主程序
	{
		描述: "v16 探针 P5：死斗里宣告回合胜利"
		模式名称: "P5 回合胜利"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

规则("P5 回合胜利")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待(5, 无视条件);
		记入查看器(自定义字符串("P5 接下来宣告回合胜利，看有没有结算/计分变化"));
		宣告回合胜利(队伍1);
		等待(5, 无视条件);
		记入查看器(自定义字符串("P5 宣告完了"));
	}
}
