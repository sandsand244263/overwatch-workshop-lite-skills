设置
{
	主程序
	{
		描述: "运行时 v4：本地玩家读取（确保人在场上）+ 击杀事件实例"
		模式名称: "r3 探针v4"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			获胜得分: 500
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: tick
		1: flag
		3: a1
		7: f4

	玩家:
		0: k4
}

规则("r0 节拍")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 90);
			等待(1, 无视条件);
			修改全局变量(tick, 加, 1);
			If(全局.tick == 5);
				设置全局变量(flag, 1);
			End;
		End;
	}
}

规则("r5 生成两个机器人并报人数")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		生成机器人(英雄(死神), 所有队伍, -1, 空, 空);
		生成机器人(英雄(安娜), 所有队伍, -1, 空, 空);
		等待(3, 无视条件);
		记入查看器(自定义字符串("[cnt] n={0} alive={1}", 玩家数量(所有队伍), 存活玩家数量(所有队伍)));
	}
}

规则("r1 等待直到是否真阻塞")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		修改全局变量(a1, 加, 1);
		等待直到(全局.flag == 1, 999);
		修改全局变量(a1, 加, 1);
		记入查看器(自定义字符串("[r1] a1={0} wait_t={1}", 全局.a1, 全局.tick));
	}
}

规则("r3a 全局规则读本地玩家")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 8);
			等待(1, 无视条件);
			记入查看器(自定义字符串("[r3a] hp_lp={0} hpmax_lp={1}", 生命值(本地玩家), 最大生命值(本地玩家)));
		End;
	}
}

规则("r3b 每名玩家读事件玩家")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		全局.tick < 4;
	}

	动作
	{
		While(全局.tick < 4);
			等待(1, 无视条件);
			记入查看器(自定义字符串("[r3b] hp_ep={0} hpmax_ep={1}", 生命值(事件玩家), 最大生命值(事件玩家)));
		End;
	}
}

规则("r4a 第8秒起全场互殴")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		全局.tick >= 8;
	}

	动作
	{
		While(全局.tick < 30);
			等待(2, 无视条件);
			伤害(事件玩家, 所有玩家(所有队伍), 25);
		End;
	}
}

规则("r4b 击杀事件计数")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		修改玩家变量(事件玩家, k4, 加, 1);
		修改全局变量(f4, 加, 1);
		记入查看器(自定义字符串("[r4] k4={0} f4={1}", 事件玩家.k4, 全局.f4));
	}
}

规则("r6 屏幕隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			隐藏英雄HUD(事件玩家);
			隐藏游戏模式HUD(事件玩家);
			开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
			等待(1, 无视条件);
		End;
	}
}

规则("r7 30秒判胜收尾")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		全局.tick >= 30;
	}

	动作
	{
		宣告玩家胜利(事件玩家);
	}
}
