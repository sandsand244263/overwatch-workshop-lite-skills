设置
{
	主程序
	{
		描述: "运行时 v6b：把 等待直到 写进 条件 块（实验格，可能导入被拒）"
		模式名称: "r3 探针v6b"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			获胜得分: 500
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: tick
		9: c9
}

规则("r0 节拍")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 90);
			等待(1, 无视条件);
			修改全局变量(tick, 加, 1);
		End;
	}
}

规则("r9 条件块里的等待直到")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		等待直到(全局.tick >= 5, 999);
	}

	动作
	{
		修改全局变量(c9, 加, 1);
		记入查看器(自定义字符串("[r9] 执行了 c9={0} tick={1}", 全局.c9, 全局.tick));
	}
}

规则("r6 屏幕隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			隐藏英雄HUD(事件玩家);
			隐藏游戏模式HUD(事件玩家);
			开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
			等待(1, 无视条件);
		End;
	}
}
