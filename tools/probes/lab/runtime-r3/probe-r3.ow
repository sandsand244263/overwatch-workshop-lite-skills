设置
{
	主程序
	{
		描述: "运行时三维度：等待直到 / While 条件重估 / 本地玩家读取 / 击杀事件实例"
		模式名称: "r3 探针v2"
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			获胜得分: 500
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: tick
		1: flag
		3: a1
		4: b2
		7: f4

	玩家:
		0: k4
}

规则("r0 节拍")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 90);
			等待(1, 无视条件);
			修改全局变量(tick, 加, 1);
			If(全局.tick == 5);
				设置全局变量(flag, 1);
			End;
		End;
	}
}

规则("r5 生成机器人")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		生成机器人(英雄(死神), 所有队伍, -1, 空, 空);
		生成机器人(英雄(安娜), 所有队伍, -1, 空, 空);
		生成机器人(英雄(卢西奥), 所有队伍, -1, 空, 空);
		生成机器人(英雄(莱因哈特), 所有队伍, -1, 空, 空);
	}
}

规则("r1 等待直到会不会真等")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		修改全局变量(a1, 加, 1);
		等待直到(全局.flag == 1, 999);
		修改全局变量(a1, 加, 1);
		记入查看器(自定义字符串("[r1] a1={0} wait_t={1}", 全局.a1, 全局.tick));
	}
}

规则("r2 While 等待期间条件重估")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.flag == 0);
			修改全局变量(b2, 加, 1);
			等待直到(假, 0.5);
		End;
		记入查看器(自定义字符串("[r2] b2={0} loop_t={1}", 全局.b2, 全局.tick));
	}
}

规则("r3 本地玩家当读取")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(真);
			等待(1, 无视条件);
			记入查看器(自定义字符串("[r3] hp={0} hpmax={1}", 生命值(本地玩家), 最大生命值(本地玩家)));
		End;
	}
}

规则("r4 击杀事件每名玩家")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		修改玩家变量(事件玩家, k4, 加, 1);
		修改全局变量(f4, 加, 1);
		记入查看器(自定义字符串("[r4] k4={0} f4={1}", 事件玩家.k4, 全局.f4));
	}
}

规则("r6 屏幕隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			隐藏英雄HUD(事件玩家);
			隐藏游戏模式HUD(事件玩家);
			开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
			等待(1, 无视条件);
		End;
	}
}

规则("r7 收尾自动结束比赛")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 30, 999);
		宣告玩家胜利(主机玩家);
	}
}
