设置
{
	主程序
	{
		描述: "运行时 v6：等待直到超时后是否继续 + 两次定点击杀的击杀者私有计数"
		模式名称: "r3 探针v6"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			获胜得分: 500
		}

		综合
		{
			游戏模式开始: 即时
			随机英雄复生: 开启
		}
	}
}

变量
{
	全局:
		0: tick
		7: f4

	玩家:
		0: k4
}

规则("r0 节拍")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		While(全局.tick < 90);
			等待(1, 无视条件);
			修改全局变量(tick, 加, 1);
		End;
	}
}

规则("r5 生成四个机器人")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		生成机器人(英雄(死神), 所有队伍, -1, 空, 空);
		生成机器人(英雄(安娜), 所有队伍, -1, 空, 空);
		生成机器人(英雄(路霸), 所有队伍, -1, 空, 空);
		生成机器人(英雄(卢西奥), 所有队伍, -1, 空, 空);
	}
}

规则("r10 等待直到超时后是否继续")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 3, 999);
		记入查看器(自定义字符串("[r10a] 门开了 tick={0}", 全局.tick));
		等待直到(假, 4);
		记入查看器(自定义字符串("[r10b] 超时之后 tick={0}", 全局.tick));
	}
}

规则("r4c 两次定点击杀")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(全局.tick >= 25, 999);
		伤害(数组中的值(所有玩家(所有队伍), 1), 数组中的值(所有玩家(所有队伍), 0), 1000);
		等待(2, 无视条件);
		伤害(数组中的值(所有玩家(所有队伍), 3), 数组中的值(所有玩家(所有队伍), 2), 1000);
	}
}

规则("r4b 击杀事件计数")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		修改玩家变量(事件玩家, k4, 加, 1);
		修改全局变量(f4, 加, 1);
		记入查看器(自定义字符串("[r4] k4={0} f4={1} tick={2}", 事件玩家.k4, 全局.f4, 全局.tick));
	}
}

规则("r6 屏幕隐蔽")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			隐藏英雄HUD(事件玩家);
			隐藏游戏模式HUD(事件玩家);
			开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);
			等待(1, 无视条件);
		End;
	}
}
