设置
{
	主程序
	{
		模式名称: "名字表回归"
	}

	模式
	{
		死斗
		{
			启用地图
			{
				艾兴瓦尔德 972777519512094292
			}
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			路霸
			{
				终极技能充能速度（鸡飞狗跳）: 100%
				战斗时终极技能充能速度 鸡飞狗跳: 34%
				链钩冷却时间: 20%
			}
		}
	}
}

变量
{
	全局:
		0: g
		1: i
}

子程序
{
	0: S_Probe
}

规则("名字表回归")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		所用英雄(本地玩家) == 英雄(路霸);
	}

	动作
	{
		If(按钮被按下(本地玩家, 按钮(终极技能)));
			调用子程序(S_Probe);
			设置全局变量(g, 1);
		End;
		设置移动速度(本地玩家, 速度(本地玩家) * 1.2);
	}
}

规则("名字表子程序")
{
	事件
	{
		子程序;
		S_Probe;
	}

	动作
	{
		设置全局变量(i, 0);
	}
}
