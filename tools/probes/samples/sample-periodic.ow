// 样例：全局心跳（周期性执行）
// 适用：全场共享一个计时器，比如每 3 秒加一次资源
// 不要用：每个玩家各算各的时间——那要改成「持续 - 每名玩家」，否则所有人共用一个计数器
设置
{
	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: Seconds
}

规则("心跳")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(正在设置 == 假, 60);      // 等加载/准备阶段结束
		等待(6, 无视条件);                 // 再避开开局倒计时（实测约 5 秒）
		While(真);
			等待(3, 无视条件);
			全局.Seconds = 全局.Seconds + 3;
			大字体信息(所有玩家(所有队伍), 自定义字符串("已过 {0} 秒", 全局.Seconds));
		End;
	}
}
