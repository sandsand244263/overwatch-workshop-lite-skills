// 样例：事件驱动（击杀计数 + 播报）
// 适用：击杀、死亡、受到伤害这类由游戏事件触发的逻辑
// 不要用：需要按时间轮询时——事件不会自己重复触发，那种情况用心跳样例
设置
{
	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}
	}
}

变量
{
	玩家:
		0: Kills
}

规则("击杀计数")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		事件玩家.Kills = 事件玩家.Kills + 1;
		If(事件玩家.Kills >= 3);
			大字体信息(事件玩家, 自定义字符串("{0} 三杀！", 事件玩家));
		End;
	}
}

规则("决出胜负")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		If(事件玩家.Kills >= 10);
			宣告玩家胜利(事件玩家);
		End;
	}
}
