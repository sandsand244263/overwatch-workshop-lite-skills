设置
{
	主程序
	{
		描述: "正例：值名都在表里"
		模式名称: "值名合法"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

变量
{
	全局:
		0: g1
		1: g2
}

规则("值名合法")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			等待(0.500, 无视条件);
			全局.g1 = 事件玩家;
			全局.g2 = 英雄(莱因哈特);
			If(数组包含(数组(英雄(狂鼠), 英雄(法老之鹰)), 所用英雄(事件玩家)));
				记入查看器(自定义字符串("值名都合法 {0}", 全局.g2));
			End;
			如条件为“假”则中止;
		End;
	}
}
