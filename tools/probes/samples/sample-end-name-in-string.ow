// 样例：动作名只出现在字符串/注释里，不构成调用（不该报必改）
// 用途：`check_game_end_actions` 的「不误报」回归——死斗里 宣告队伍胜利 只写在描述、规则名、
//       查看器文案、// 注释、/* */ 块注释里，一条真语句都没有 → 必须 0 命中。
// 对照组：tools/probes/negative/ffa-draw.ow（真写了 宣布比赛为平局(); → 必须报）
设置
{
	主程序
	{
		描述: "反例：动作名只写在字符串里——宣告队伍胜利、宣布比赛为平局 都不算调用"
		模式名称: "sample 字符串里的动作名"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 0
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			随机英雄复生: 开启
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: tick
}

// 死斗里别写 宣告队伍胜利(队伍1)——这行只是注释，不算调用
规则("sample 死斗里别用宣告队伍胜利")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待直到(游戏正在进行中() == 真, 120);
		/* 宣告队伍胜利(队伍1) 写在块注释里同样不算调用 */
		记入查看器(自定义字符串("[sample] 文案里提到 宣告队伍胜利 这个词，但真语句没写"));
		全局.tick = 全局.tick + 1;
	}
}
