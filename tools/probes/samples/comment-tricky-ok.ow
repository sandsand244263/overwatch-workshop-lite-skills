设置
{
	主程序
	{
		描述: "注释怪写法正样本（M2 Task 2.3）：http:// 在字符串里、// 独占一行、/* */ 段、跨行数组里带注释"
	}
}

变量
{
	全局:
		0: gArr // 【数组】注释紧贴名字、前面不带空格（#8 那种写法，改名也得认出来）
		1: gFlag // 【开关】
}

// 独占一行的行注释：删掉它不该影响下面任何东西
规则("注释怪写法")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		全局.gFlag == 真;
	}

	动作
	{
		/* 单行块注释 */
		全局.gArr = 数组(1, 2,
			// 跨行数组里的注释：删掉这条，括号和逗号不能被带坏（#17 同族）
			3
		);
		"独占一行的字符串注释：整行就是一个字符串，删注释时它也该走"
		小字体信息(报什么玩家(主机玩家), 自定义字符串("跳到 http://example.com/a//b 看，两个斜杠是内容"));
		全局.gFlag = 真;
	}
}

/*
块注释段（独占多行）
中间有分号 ; 和括号 ) 也不该把后面的语句吃掉
*/
