// 样例：数组 vs 数值（「加」这条检查的两端）
// 适用：数值要累加写 加、数组要追加写 添加至数组——两头都别写错
// 不要用：没有数组变量时——那本来就不会有追加需求
设置
{
	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			获胜得分: 20
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: score
		1: arr
}

规则("数值累加与数组追加")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		全局.arr = 数组(1, 2, 3);
		修改全局变量(score, 加, 1);              // 数值累加：正常写法
		修改全局变量(arr, 添加至数组, 4);        // 数组追加：正确写法
	}
}
