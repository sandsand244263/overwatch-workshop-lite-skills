// 样例：倒计时（条件等待）
// 适用：有明确结束条件，比如限时 60 秒
// 不要用：要无限循环时——条件一开始就是假，整段会被直接跳过
// 注意：用「团队死斗」，因为「宣布比赛为平局」在死斗（自由混战）里无效；
//       死斗要结束比赛只能用「宣告玩家胜利(某玩家)」
设置
{
	模式
	{
		团队死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
			队伍1获胜所需分数: 30
			队伍2获胜所需分数: 30
		}

		综合
		{
			游戏模式开始: 即时
			复生时间: 5%
		}
	}
}

变量
{
	全局:
		0: TimeLeft
}

规则("倒计时")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		全局.TimeLeft = 60;
		While(全局.TimeLeft > 0);
			等待(1, 无视条件);
			全局.TimeLeft = 全局.TimeLeft - 1;
			大字体信息(所有玩家(所有队伍), 自定义字符串("剩余 {0} 秒", 全局.TimeLeft));
		End;
		宣布比赛为平局();
	}
}
