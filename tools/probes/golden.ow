设置
{
	主程序
	{
		模式名称: "猪钩测点工具"
	}

	大厅
	{
		比赛语音聊天: 启用
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			启用地图
			{
				黑森林 972777519512063901
			}
		}

		综合
		{
			允许切换英雄: 关闭
			急救包刷新: 禁用
			游戏模式开始: 即时
			英雄限制: 关闭
			随机英雄复生: 开启
		}
	}

	英雄
	{
		综合
		{
			被动生命值恢复: 关闭

			路霸
			{
				伤害量: 10%
				受到伤害量: 10%
				受到治疗量: 400%
				战斗时终极技能充能速度 鸡飞狗跳: 34%
				无需装弹: 开启
				终极技能自动充能速度 鸡飞狗跳: 0%
				被动生命值恢复: 关闭
				重生时终极技能充能完毕: 关闭
				链钩冷却时间: 20%
			}

			启用英雄
			{
				路霸
			}
		}
	}
}

规则("|玩家|飞行")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(跳跃)) == 真;
		事件玩家 == 主机玩家;
	}

	动作
	{
		等待(0.250, 当为“假”时中止);
		取消与环境的移动碰撞(事件玩家, 假);
		设置移动速度(事件玩家, 200);
		While(正在空中(事件玩家) == 真);
			施加推力(事件玩家, 上, 0.100, 至地图, 取消相反运动);
			If(按钮被按下(事件玩家, 按钮(跳跃)) == 真);
				施加推力(事件玩家, 上, 6, 至地图, 取消相反运动);
			Else If(按钮被按下(事件玩家, 按钮(蹲下)) == 真);
				施加推力(事件玩家, 下, 12, 至地图, 取消相反运动);
			End;
			等待(0.016, 无视条件);
		End;
		开启与环境的移动碰撞(事件玩家);
		设置移动速度(事件玩家, 100);
	}
}

规则("|玩家|传送")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(装填)) == 真;
	}

	动作
	{
		传送(事件玩家, 眼睛位置(事件玩家) + 面朝方向(事件玩家) * 5);
		等待(0.100, 无视条件);
		如条件为“真”则循环;
	}
}

规则("按跳跃键向上施加推力")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		按钮被按下(主机玩家, 按钮(跳跃)) == 真;
	}

	动作
	{
		施加推力(主机玩家, 地图矢量(上, 事件玩家, 旋转), 10, 至地图, 取消相反运动);
		等待(0.100, 无视条件);
		如条件为“真”则循环;
	}
}

规则("准星位置")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		创建效果(本地玩家, 球体, 颜色(灰色), 射线命中位置(眼睛位置(主机玩家), 眼睛位置(主机玩家) + 面朝方向(主机玩家) * 1000, 所有玩家(所有队伍), 主机玩家, 假), 0.500, 可见，位置和半径);
		创建HUD文本(本地玩家, 自定义字符串("准星坐标\nX:{0}\nY:{1}\nZ:{2}", X方向分量(射线命中位置(眼睛位置(主机玩家), 眼睛位置(主机玩家) + 面朝方向(主机玩家) * 1000, 所有玩家(所有队伍), 主机玩家, 假)),
			Y方向分量(射线命中位置(眼睛位置(主机玩家), 眼睛位置(主机玩家) + 面朝方向(主机玩家) * 1000, 所有玩家(所有队伍), 主机玩家, 假)), Z方向分量(射线命中位置(眼睛位置(主机玩家), 眼睛位置(主机玩家) + 面朝方向(
			主机玩家) * 1000, 所有玩家(所有队伍), 主机玩家, 假))), 空, 空, 右边, -1, 颜色(白色), 颜色(白色), 颜色(白色), 可见和字符串, 默认可见度);
	}
}