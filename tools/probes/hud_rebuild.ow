设置
{
	主程序
	{
		描述: "语法探测：只验证导入"
		模式名称: "语法探测"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

变量
{
	全局:
		0: totalKills
}

规则("初始HUD")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		创建HUD文本(事件玩家, 自定义字符串("击杀"), 空, 自定义字符串("{0}", 全局.totalKills), 左边, 0, 颜色(黄色), 颜色(白色), 颜色(绿色), 可见和字符串, 默认可见度);
	}
}

规则("击杀刷新HUD")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		修改全局变量(totalKills, 加, 1);
		创建HUD文本(事件玩家, 自定义字符串("击杀"), 空, 自定义字符串("{0}", 全局.totalKills), 左边, 0, 颜色(黄色), 颜色(白色), 颜色(绿色), 可见和字符串, 默认可见度);
		记入查看器(自定义字符串("KILL {0}", 全局.totalKills));
	}
}
