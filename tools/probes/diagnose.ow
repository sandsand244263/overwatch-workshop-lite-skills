设置
{
	主程序
	{
		描述: "语法探测：只验证导入"
		模式名称: "语法探测"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

变量
{
	全局:
		0: hudTicks
		1: killCount
		2: rewardCount
}

规则("HUD刷新")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		创建HUD文本(所有玩家(所有队伍), 空, 空, 自定义字符串("tick {0}", 全局.hudTicks), 左边, 0, 颜色(白色), 颜色(白色), 颜色(白色), 字符串, 默认可见度);
		修改全局变量(hudTicks, 加, 1);
		等待(0.250, 无视条件);
	}
}

规则("击杀计数")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		修改全局变量(killCount, 加, 1);
		记入查看器(自定义字符串("KILL {0}", 全局.killCount));
	}
}

规则("诊断快照")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待(3, 无视条件);
		记入查看器(自定义字符串("==T3 hud={0} kill={1} speed={2}", 全局.hudTicks, 全局.killCount, 速度(主机玩家)));
		等待(7, 无视条件);
		记入查看器(自定义字符串("==T10 hud={0} kill={1} speed={2}", 全局.hudTicks, 全局.killCount, 速度(主机玩家)));
		等待(10, 无视条件);
		记入查看器(自定义字符串("==T20 hud={0} kill={1} speed={2}", 全局.hudTicks, 全局.killCount, 速度(主机玩家)));
	}
}

规则("奖励计数")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(互动)) == 真;
	}

	动作
	{
		修改全局变量(rewardCount, 加, 1);
		设置状态(事件玩家, 空, 无敌, 2);
		设置移动速度(事件玩家, 150);
		记入查看器(自定义字符串("REWARD {0} speed={1}", 全局.rewardCount, 速度(事件玩家)));
		等待(2, 无视条件);
		设置移动速度(事件玩家, 100);
		记入查看器(自定义字符串("SPEED-RESTORE {0}", 速度(事件玩家)));
	}
}
