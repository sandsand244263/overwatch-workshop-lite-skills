设置
{
	主程序
	{
		描述: "A 少一个大括号（故意坏，别修）"
	}

	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内 972777519512064577
			}
		}

		综合
		{
			游戏模式开始: 即时
		}
	}
}

变量
{
	全局:
		0: t
		1: c1
}

规则("时钟")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		记入查看器(自定义字符串("[base] probe up"));
		等待直到(正在设置 == 假, 60);
		等待(6, 无视条件);
		While(全局.t < 10);
			等待(1, 无视条件);
			全局.t = 全局.t + 1;
		End;
		记入查看器(自定义字符串("[end] t={0}", 全局.t));
		记入查看器(自定义字符串("[end c1] c1={0}", 全局.c1));
	}
}

规则("A 少括号")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		全局.c1 = 全局.c1 + 1;
		记入查看器(自定义字符串("[a] c1={0}", 全局.c1));
	}
