规则("动作当值用")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		事件玩家.hudId = 创建HUD文本(事件玩家, 自定义字符串("x"), 空, 空,
			顶部, 0, 空, 空, 空, 可见和字符串, 默认可见度);
		记入查看器(自定义字符串("负样本：等号右边写了动作"));
	}
}
