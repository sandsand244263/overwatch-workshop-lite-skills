设置
{
	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内
			}
		}
		综合
		{
			游戏模式开始: 即时
		}
	}
}

变量
{
	全局:
		0: arr

	玩家:
		0: arr
}

规则("在索引处修改：全局变量槽写成带前缀")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		在索引处修改全局变量(全局.arr, 0, 加, 1);
	}
}

规则("在索引处修改：玩家变量槽写成带前缀")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		在索引处修改玩家变量(事件玩家, 事件玩家.arr, 0, 加, 1);
	}
}
