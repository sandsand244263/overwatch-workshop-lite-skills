规则("测试")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		隐藏英雄HUD(事件玩家);
		隐藏游戏模式HUD(事件玩家);
		开始镜头(事件玩家, 矢量(0, 50, 0), 矢量(0, 200, 0), 100);   // 工位隐蔽：镜头移到空白处，画面里没有角色
		记入查看器(自定义字符串("[测试] 开始"));
	}
}

规则("OR 条件测试")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		(死亡(事件玩家) == 真 || 正在使用表情交流(事件玩家) == 真);
	}

	动作
	{
		记入查看器(自定义字符串("[测试] OR"));
	}
}
