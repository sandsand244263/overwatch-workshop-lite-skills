设置
{
	模式
	{
		死斗
		{
			启用地图
			{
				地图工坊室内
			}
		}
		综合
		{
			游戏模式开始: 即时
		}
	}
}

变量
{
	全局:
		0: tick

	玩家:
		0: hudId
}

规则("每半秒重刷 HUD")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
		While(真);
			消除HUD文本(事件玩家.hudId);
			创建HUD文本(事件玩家, 自定义字符串("分数"), 空, 自定义字符串("{0}", 全局.tick), 左边, 0, 颜色(黄色), 颜色(白色), 颜色(绿色), 可见和字符串, 默认可见度);
			等待(0.5, 无视条件);
		End;
	}
}
