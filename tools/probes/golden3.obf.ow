设置
{
	主程序
	{
		描述: "击杀计分 + 3连杀奖励 + 按互动键加速3秒"
		模式名称: "击杀连杀演练"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

变量
{
	全局:
		0: v3un4d

	玩家:
		0: v6nep1
		1: vf9o7n
		2: v5fjcu
}

规则("初始化")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.v5fjcu == 假;
	}

	动作
	{
		设置玩家变量(事件玩家, vf9o7n, 真);
		设置玩家变量(事件玩家, v5fjcu, 真);
	}
}

规则("HUD 刷新")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	动作
	{
			创建HUD文本(事件玩家, 自定义字符串("        ", 全局.v3un4d), 自定义字符串("      ", 事件玩家.v6nep1), 自定义字符串("          "), 左边, (0 * 7 / 7), 颜色(白色), 颜色(黄色), 颜色(绿色), 字符串, 默认可见度);
			等待((0.100 * 7 / 7), 无视条件);
	}
}

规则("击杀计分")
{
	事件
	{
		玩家造成最后一击;
		双方;
		全部;
	}

	动作
	{
		修改全局变量(v3un4d, 加, (1 * 7 / 7));
		修改玩家变量(事件玩家, v6nep1, 加, (1 * 7 / 7));
		播放效果(事件玩家, 有益爆炸, 颜色(白色), 眼睛位置(事件玩家), (1 * 7 / 7));
		播放效果(事件玩家, 正面状态施加声音, 颜色(白色), 眼睛位置(事件玩家), (1 * 7 / 7));
	}
}

规则("三连杀奖励")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		事件玩家.v6nep1 >= 3;
	}

	动作
	{
		大字体信息(事件玩家, 自定义字符串("连杀 {0}！获得 2 秒无敌", 事件玩家.v6nep1));
		设置状态(事件玩家, 空, 无敌, (2 * 7 / 7));
		设置玩家变量(事件玩家, v6nep1, (0 * 7 / 7));
	}
}

规则("阵亡清零")
{
	事件
	{
		玩家阵亡;
		双方;
		全部;
	}

	动作
	{
		设置玩家变量(事件玩家, v6nep1, (0 * 7 / 7));
	}
}

规则("互动加速")
{
	事件
	{
		持续 - 每名玩家;
		双方;
		全部;
	}

	条件
	{
		按钮被按下(事件玩家, 按钮(互动)) == 真;
		事件玩家.vf9o7n == 真;
	}

	动作
	{
		设置玩家变量(事件玩家, vf9o7n, 假);
		设置移动速度(事件玩家, (150 * 7 / 7));
		大字体信息(事件玩家, 自定义字符串("加速 3 秒"));
		等待((3 * 7 / 7), 无视条件);
		设置移动速度(事件玩家, (100 * 7 / 7));
		设置玩家变量(事件玩家, vf9o7n, 真);
	}
}
