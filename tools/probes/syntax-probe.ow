设置
{
	主程序
	{
		描述: "语法探测：只验证导入"
		模式名称: "语法探测"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

变量
{
	全局:
		0: counter
		1: arr
}

规则("语法探测")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		记入查看器(自定义字符串("语法探测 开始"));
		全局.counter = 0;
		While(全局.counter < 3);
			全局.counter += 1;
			等待(0.016, 无视条件);
		End;
		If(全局.counter == 3);
			记入查看器(自定义字符串("While 通过 {0}", 全局.counter));
		Else If(全局.counter > 3);
			记入查看器(自定义字符串("分支异常 A"));
		Else;
			记入查看器(自定义字符串("分支异常 B"));
		End;
		修改全局变量(arr, 添加至数组, 全局.counter);
		记入查看器(自定义字符串("数组首项 {0}", 全局.arr[1]));
		记入查看器(字符串("{0} {1} {2}", 自定义字符串("A"), 自定义字符串("B"), 自定义字符串("C")));
		记入查看器(全局.counter == 3 ? 自定义字符串("三元真") : 自定义字符串("三元假"));
		记入查看器(自定义字符串("语法探测 结束"));
	}
}
