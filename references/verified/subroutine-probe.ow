设置
{
	主程序
	{
		描述: "子程序探测：只验证导入"
		模式名称: "子程序探测"
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 开启
			游戏模式开始: 即时
			英雄限制: 每队同一英雄最多2名
		}
	}
}

子程序
{
	1: Probe
}

规则("子程序定义")
{
	事件
	{
		子程序;
		Probe;
	}

	动作
	{
		记入查看器(自定义字符串("子程序执行了"));
	}
}

规则("调用子程序")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待(0.500, 无视条件);
		调用子程序(Probe);
	}
}
