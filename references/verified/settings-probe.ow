设置
{
	主程序
	{
		描述: "设置词表探测：只验证导入，不用玩"
		模式名称: "设置探测"
	}

	大厅
	{
		地图轮换: 完成比赛后
		比赛结束后转换队伍: 否
		玩家上限 队伍1: 6
		玩家上限 队伍2: 0
		观战者人数上限: 6
		返回大厅: 从不
		队列中的玩家可以加入: 是
	}

	模式
	{
		死斗
		{
			重装职责被动生命值加成: 禁用
		}

		综合
		{
			复生时间: 1%
			急救包刷新: 依据比赛模式而定
			游戏模式开始: 手动
			英雄限制: 每队同一英雄最多1名
		}
	}

	英雄
	{
		综合
		{
			被动生命值恢复: 关闭
		}
	}
}

规则("探测")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		等待(1, 无视条件);
		记入查看器(自定义字符串("设置探测 导入成功"));
	}
}
